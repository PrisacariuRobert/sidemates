{
  "name": "sidemates",
  "version": "0.42.0",
  "private": true,
  "type": "module",
  "description": "A local-first, open-source home for persistent AI teammates.",
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:remote": "OPENBOT_HOST=0.0.0.0 concurrently -k -n server,web -c cyan,magenta \"npm:dev:server\" \"vite --host 0.0.0.0\"",
    "remote": "npm run build && OPENBOT_HOST=0.0.0.0 NODE_ENV=production tsx src/server/index.ts",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build && node scripts/build-apple-ai.mjs",
    "start": "NODE_ENV=production tsx src/server/index.ts",
    "desktop": "npm --prefix desktop start",
    "mcp": "node --import tsx mcp/openbot.ts",
    "test": "tsx --test --test-concurrency=4 src/**/*.test.ts",
    "test:provider-runtime": "tsx scripts/test-provider-runtime.ts",
    "test:provider-test-ui": "tsx scripts/test-provider-test-ui.ts",
    "test:onboarding": "tsx scripts/test-onboarding.ts",
    "test:calendar-routines": "tsx scripts/test-calendar-routines.ts",
    "test:work-sources-ui": "tsx scripts/test-work-sources-ui.ts",
    "test:recipes-memory-ui": "tsx scripts/test-recipes-memory-ui.ts",
    "test:browser-sessions": "tsx scripts/test-browser-session-workflows.ts",
    "test:browser-tabs": "tsx scripts/test-browser-tabs.ts",
    "test:browser-sign-in": "tsx scripts/test-browser-sign-in.ts",
    "test:r01-http-fixtures": "tsx scripts/run-r01-http-fixtures.ts",
    "test:computer-use-fixtures": "tsx scripts/run-browser-integration-fixtures.ts",
    "test:workflow-checks-ui": "tsx scripts/test-workflow-checks-ui.ts",
    "test:skill-authoring-ui": "tsx scripts/test-skill-authoring-ui.ts",
    "test:customer-workflow-ui": "tsx scripts/test-customer-workflow-ui.ts",
    "test:live-computer-ui": "tsx src/studio/LiveComputer.browser.ts",
    "test:task-tokens-ui": "npm run build && tsx src/studio/TaskTokens.browser.ts",
    "test:browser-workflow-ui": "npm run build && tsx src/studio/BrowserWorkflow.browser.ts",
    "test:studio-design": "tsx scripts/test-studio-design.ts",
    "test:new-studio": "tsx scripts/test-new-studio.ts",
    "test:first-teammate": "tsx scripts/test-first-teammate.ts",
    "test:run-controls": "tsx src/studio/RunControls.browser.ts",
    "test:app-approvals": "tsx src/components/AppApprovals.browser.ts",
    "test:unified-studio": "tsx scripts/test-unified-studio.ts",
    "test:studio-polish": "tsx src/studio/StudioPolish.browser.ts",
    "test:draft-attachments": "tsx scripts/test-draft-attachments-api.ts",
    "test:conversation-flow": "npm run test:new-studio && npm run test:first-teammate && npm run test:run-controls && npm run test:draft-attachments",
    "benchmark:site-workflow": "tsx scripts/benchmark-site-workflow.ts",
    "test:away-access": "tsx scripts/test-away-access.ts",
    "test:https-tunnel": "tsx scripts/test-https-tunnel.ts",
    "relay:serve": "tsx scripts/relay-server.ts",
    "test:code-runtime": "tsx scripts/test-code-runtime.ts",
    "test:productivity-runtime": "tsx scripts/test-productivity-runtime.ts",
    "benchmark:workflows": "tsx scripts/benchmark-workflows.ts",
    "benchmark:expenses": "tsx scripts/benchmark-expenses.ts",
    "benchmark:extensions": "tsx scripts/benchmark-extensions.ts",
    "benchmark:page-watch": "tsx scripts/benchmark-page-watch.ts",
    "benchmark:repeat-loop": "tsx scripts/benchmark-repeat-loop.ts",
    "soak:routines": "tsx scripts/soak-routines.ts",
    "check": "tsc --noEmit",
    "check:acceptance": "tsc --noEmit -p tsconfig.acceptance.json",
    "test:packaging": "node --test scripts/test-staged-app-package.mjs scripts/test-release-version.mjs scripts/test-release-workflow.mjs scripts/test-macos-dmg.mjs scripts/test-mac-signing.mjs",
    "test:desktop": "node --test desktop/*.test.mjs",
    "check:release": "node scripts/check-release.mjs",
    "qualify:product": "tsx scripts/qualify-product.ts",
    "verify": "npm run check:release && npm run test:packaging && npm run test:desktop && npm run build && npm test && npm run check && npm run check:acceptance",
    "package:desktop": "node scripts/package-desktop.mjs",
    "package:desktop:signed": "node scripts/package-desktop.mjs --signed"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/open-sans": "^5.3.0",
    "@js-temporal/polyfill": "0.5.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "cheerio": "1.2.0",
    "express": "^5.2.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.41.0",
    "music-metadata": "^11.15.0",
    "pdfjs-dist": "^6.3.289",
    "playwright-core": "^1.62.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.13",
    "web-push": "^3.6.7",
    "ws": "^8.21.3",
    "yaml": "2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "overrides": {
    "shell-quote": "^1.12.0"
  }
}
